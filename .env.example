# FoodBridge Environment Configuration Example

# Database (PostgreSQL with PostGIS extension)
DATABASE_URL="postgresql://foodbridge_admin:secret_pass_2026@localhost:5432/foodbridge_db?schema=public&sslmode=disable"

# Next.js Server
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Python AI Engine Microservice
AI_MICROSERVICE_URL="http://localhost:8000"

# Cryptographic SHA256/HMAC Proof-of-Handoff Secret
HMAC_SECRET_KEY="FOODBRIDGE_SECRET_HMAC_KEY_2026"

# Routing APIs (OpenRouteService / OSRM)
OSRM_API_URL="http://router.project-osrm.org"
OPENROUTESERVICE_API_KEY="your_openrouteservice_api_key_here"
